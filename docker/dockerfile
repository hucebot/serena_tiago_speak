FROM ros:humble-ros-base

# ROS deps + Festival TTS (used by the tiago_speaks node)
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3-pip \
    python3-tk \
    tk \
    festival \
    festvox-kallpc16k \
    alsa-utils \
    ros-humble-rmw-cyclonedds-cpp \
    ros-humble-tf2-ros \
    ros-humble-tf2-geometry-msgs \
    ros-humble-tf2-py \
    ros-humble-geometry-msgs \
    ros-humble-visualization-msgs \
    ros-humble-rviz2 \
    ros-humble-rqt \
    ros-humble-rqt-common-plugins \
    && rm -rf /var/lib/apt/lists/*

# Extra Festival voices (separate layer so the ROS/Festival cache stays valid)
RUN apt-get update && apt-get install -y --no-install-recommends \
    festvox-kdlpc16k \
    festvox-rablpc16k \
    festvox-don \
    festvox-ellpc11k \
    mbrola mbrola-en1 \
    && rm -rf /var/lib/apt/lists/*

# Source ROS automatically in interactive shells
RUN echo "source /opt/ros/humble/setup.bash" >> ~/.bashrc

WORKDIR /workspace
